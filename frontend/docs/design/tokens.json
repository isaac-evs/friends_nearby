{
  "$meta": {
    "name": "¿Jalas? — Nearby Friends",
    "version": "0.1.0",
    "note": "Fuente de verdad de los tokens. theme.css los expone a Tailwind v4."
  },
  "color": {
    "bg": "#F6F6F8",
    "surface": "#FFFFFF",
    "surface-muted": "#F1F1F4",
    "surface-sunken": "#ECECF0",
    "ink": "#111114",
    "text": "#34343C",
    "muted": "#5B5B66",
    "placeholder": "#8A8A96",
    "border": "rgba(17, 17, 20, 0.08)",
    "border-input": "#DADAE2",
    "border-dashed": "#C9C9D4",
    "primary": "#3D3BD4",
    "primary-hover": "#2B29A8",
    "primary-soft": "#E3DFFF",
    "on-primary": "#FFFFFF",
    "accent": "#FF7A45",
    "accent-soft": "#FFE9DF",
    "accent-text": "#B53A12",
    "danger": "#C43D1B",
    "success": "#2BB673",
    "category": {
      "cafe": "#FFE1CF",
      "correr": "#FFD3BF",
      "deporte": "#D6EBFF",
      "estudiar": "#E3DFFF",
      "comer": "#FFEDB8",
      "social": "#E3DFFF",
      "musica": "#CDEFDF",
      "clase": "#FFDDE8",
      "otro": "#ECECF0"
    },
    "avatar": ["#FFEDB8", "#CDEFDF", "#FFDDE8", "#E3DFFF", "#D6EBFF", "#FFE1CF"],
    "map": {
      "land": "#EEEEF0",
      "park": "#DDEFE3",
      "water": "#D6EBFF",
      "road": "#FFFFFF",
      "label": "#6B6A7C",
      "zone-fill": "rgba(61, 59, 212, 0.10)",
      "zone-stroke": "#3D3BD4"
    }
  },
  "font": {
    "family": "'Plus Jakarta Sans', system-ui, sans-serif",
    "weights": [400, 500, 600, 700, 800]
  },
  "type": {
    "display": { "size": 36, "weight": 800, "lineHeight": 1.05, "tracking": -1.2 },
    "h1": { "size": 28, "weight": 800, "lineHeight": 1.1, "tracking": -0.8 },
    "h2": { "size": 22, "weight": 800, "lineHeight": 1.18, "tracking": -0.5 },
    "h3": { "size": 17, "weight": 800, "lineHeight": 1.25, "tracking": -0.3 },
    "body": { "size": 16, "weight": 500, "lineHeight": 1.5 },
    "body-sm": { "size": 14, "weight": 500, "lineHeight": 1.45 },
    "label": { "size": 14, "weight": 700, "lineHeight": 1.2 },
    "meta": { "size": 13, "weight": 500, "lineHeight": 1.4 },
    "caption": { "size": 12, "weight": 600, "lineHeight": 1.35 },
    "overline": { "size": 10, "weight": 700, "lineHeight": 1, "tracking": 1.2, "transform": "uppercase" }
  },
  "radius": { "sm": 10, "md": 14, "lg": 16, "xl": 22, "card": 26, "pill": 999 },
  "space": [0, 2, 4, 6, 8, 10, 12, 14, 16, 20, 24, 32, 40],
  "shadow": {
    "xs": "0 1px 4px rgba(17, 17, 20, 0.12)",
    "sm": "0 2px 8px rgba(17, 17, 20, 0.06)",
    "md": "0 6px 18px rgba(17, 17, 20, 0.08)",
    "lg": "0 10px 30px rgba(17, 17, 20, 0.10)",
    "card": "0 14px 34px rgba(17, 17, 20, 0.10)",
    "primary": "0 10px 24px rgba(61, 59, 212, 0.35)"
  },
  "size": {
    "touch-min": 44,
    "tabbar-height": 68,
    "tabbar-inset": 12,
    "mobile-width": 390,
    "desktop-sidebar": 220,
    "desktop-panel": 360
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "swipe": "260ms",
    "easing": "cubic-bezier(0.2, 0.8, 0.2, 1)"
  }
}
